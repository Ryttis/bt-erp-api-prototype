PORT=3000
# Required: supply deployment values outside version control.
# Generate with: openssl rand -base64 48. The calling service sends it as
# Authorization: Bearer <token>. It must be at least 32 characters.
ERP_ANALYTICS_API_TOKEN=
ERP_REPLICA_HOST=
ERP_REPLICA_PORT=3306
ERP_REPLICA_DATABASE=infot_2
ERP_REPLICA_USER=
ERP_REPLICA_PASSWORD=
# Current replica does not support TLS. Set true only for a TLS-enabled replica.
ERP_REPLICA_SSL=false
ERP_REPLICA_CONNECTION_LIMIT=4
ERP_REPLICA_QUERY_TIMEOUT_MS=30000
ERP_ANALYTICS_CONCURRENCY=3
ERP_ANALYTICS_QUEUE_LIMIT=6
ERP_ANALYTICS_QUEUE_TIMEOUT_MS=1000
ERP_SLOW_QUERY_MS=1000
MAX_REQUEST_URL_LENGTH=4096
# Temporary MP-8 Slice 6P pilot. When true, only the settled-month locked truck
# fixed-cost summary is served; breakdown, dimensions and other scopes stay disabled.
ERP_FIXED_COST_TRUCK_SUMMARY_PILOT_ENABLED=false
# Temporary MP-8 pilot. When true, only the single-trailer (trailerId) settled-month
# fixed-cost summary and breakdown are served; it never enables the truck scope.
ERP_FIXED_COST_TRAILER_PILOT_ENABLED=false
